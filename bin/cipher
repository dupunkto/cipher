#!/bin/sh

set -e

. arg

required curl
required jq
required node

: "${CIPHER_ENDPOINT:=cipher.dupunkto.org}"

case "$CIPHER_ENDPOINT" in
  *://*) ;;
  *) CIPHER_ENDPOINT=https://$CIPHER_ENDPOINT ;;
esac

usage() {
  echo "Usage: cipher <command> [options]"
  echo
  echo "HIGH LEVEL COMMANDS"
  echo "  encrypt [options] <input>     Provision key and encrypt secret."
  echo "  decrypt <input>               Decrypt secret with embedded key."
  echo
  echo "LOW LEVEL COMMANDS"
  echo "  keygen [options]              Generate key."
  echo "  keyuse <kid>                  Substract key use."
  echo "  inspect <kid>                 Inspect key metadata."
  echo
  echo "OPTIONS"
  echo "  --uses, -u <int>              The amount of uses a key has."
  echo "  --expiry, -e <int>            The expiry interval for a key in hours."
  echo "  --format, -f <url|blob>       Return secret as blob or URL."
  echo
  echo "Use - to read input from stdin."
  echo
  exit 0
}

# Validation helpers

validate_endpoint() {
  case "$CIPHER_ENDPOINT" in
    http://?*|https://?*) ;;
    *) err "invalid endpoint '$CIPHER_ENDPOINT'" ;;
  esac

  authority=${CIPHER_ENDPOINT#*://}
  case "$authority" in
    ''|*/*|*'?'*|*'#'*|*' '*) err "invalid endpoint '$CIPHER_ENDPOINT'" ;;
  esac
}

validate_policy() {
  case "$uses" in
    -1) ;;
    ''|*[!0-9]*) err 'uses must be a positive integer or -1' ;;
    *) [ "$uses" -gt 0 ] || err 'uses must be a positive integer or -1' ;;
  esac

  case "$expiry" in
    ''|*[!0-9]*) err 'expiry must be a positive integer' ;;
    *) [ "$expiry" -gt 0 ] || err 'expiry must be a positive integer' ;;
  esac
}

validate_kid() {
  case "$1" in
    ''|*[!a-zA-Z0-9_-]*) err 'invalid key id' ;;
  esac
}

# API helper

api() {
  method=$1
  path=$2
  body=${3:-}
  response=$(mktemp "${TMPDIR:-/tmp}/cipher.XXXXXX") || {
    err 'could not create temporary file'
    return 1
  }

  if [ "$method" = POST ]; then
    if code=$(curl --connect-timeout 10 --max-time 30 -sS -o "$response" -w '%{http_code}' \
      -H 'Accept: application/json' -H 'Content-Type: application/json' \
      -X POST --data "$body" "$CIPHER_ENDPOINT$path"); then
      status=0
    else
      status=$?
    fi
  else
    if code=$(curl --connect-timeout 10 --max-time 30 -sS -o "$response" -w '%{http_code}' \
      -H 'Accept: application/json' "$CIPHER_ENDPOINT$path"); then
      status=0
    else
      status=$?
    fi
  fi

  if [ "$status" -ne 0 ]; then
    rm -f "$response"
    err 'API request failed'
    return 1
  fi

  if ! jq -e . "$response" >/dev/null 2>&1; then
    rm -f "$response"
    err 'API returned malformed JSON'
    return 1
  fi

  case "$code" in
    2??) ;;
    *)
      message=$(jq -r '.error // empty' "$response")
      rm -f "$response"
      [ -n "$message" ] || message="API request failed (HTTP $code)"
      err "$message"
      return 1
      ;;
  esac

  cat "$response"
  rm -f "$response"
}

# Crypto helpers

crypto() {
  operation=$1
  node -e '
    const crypto = require("crypto");
    const operation = process.argv[1];
    const input = require("fs").readFileSync(0);
    const split = input.indexOf(10);

    const decodeKey = value => {
      if (!/^(?:[A-Za-z0-9+/]{4})*(?:[A-Za-z0-9+/]{2}==|[A-Za-z0-9+/]{3}=)?$/.test(value)) throw new Error();
      const key = Buffer.from(value, "base64");
      if (key.length !== 32 || key.toString("base64") !== value) throw new Error();
      return key;
    };

    const decodeCiphertext = value => {
      if (!/^[A-Za-z0-9_-]+$/.test(value)) throw new Error();
      const padding = "=".repeat((4 - value.length % 4) % 4);
      const bytes = Buffer.from(value.replace(/-/g, "+").replace(/_/g, "/") + padding, "base64");
      const canonical = bytes.toString("base64").replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
      if (canonical !== value || bytes.length < 28) throw new Error();
      return bytes;
    };

    try {
      if (operation === "validate") {
        decodeCiphertext(input.toString("ascii"));
        process.exit(0);
      }
      if (split < 1) throw new Error();
      const key = decodeKey(input.subarray(0, split).toString("ascii"));
      const value = input.subarray(split + 1);

      if (operation === "encrypt") {
        const iv = crypto.randomBytes(12);
        const cipher = crypto.createCipheriv("aes-256-gcm", key, iv);
        const encrypted = Buffer.concat([cipher.update(value), cipher.final(), cipher.getAuthTag()]);
        process.stdout.write(Buffer.concat([iv, encrypted]).toString("base64").replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, ""));
      } else if (operation === "decrypt") {
        const bytes = decodeCiphertext(value.toString("ascii"));
        const decipher = crypto.createDecipheriv("aes-256-gcm", key, bytes.subarray(0, 12));
        decipher.setAuthTag(bytes.subarray(bytes.length - 16));
        process.stdout.write(Buffer.concat([decipher.update(bytes.subarray(12, -16)), decipher.final()]));
      } else {
        throw new Error();
      }
    } catch (_) {
      process.exit(1);
    }
  ' "$operation"
}

# Node helpers

parse_payload() {
  if [ "$#" -eq 0 ]; then
    payload=$(do_parse_payload) || err 'malformed blob or URL'
  else
    payload=$(printf '%s' "$1" | do_parse_payload) || err 'malformed blob or URL'
  fi

  kid=$(printf '%s' "$payload" | jq -r '.kid')
  ciphertext=$(printf '%s' "$payload" | jq -r '.sec')

  printf '%s' "$ciphertext" | crypto validate || err 'malformed ciphertext'
}

do_parse_payload() {
  node -e '
    const value = require("fs").readFileSync(0, "utf8").replace(/\r?\n$/, "");
    try {
      let kid, sec;
      if (/^https?:\/\//.test(value)) {
        const url = new URL(value);
        if (url.pathname !== "/receive" || url.hash || url.username || url.password) throw new Error();
        if ([...url.searchParams.keys()].some(k => k !== "kid" && k !== "sec")) throw new Error();
        if (url.searchParams.getAll("kid").length !== 1 || url.searchParams.getAll("sec").length !== 1) throw new Error();
        kid = url.searchParams.get("kid");
        sec = url.searchParams.get("sec");
      } else {
        const separator = value.indexOf(":");
        if (separator < 1 || separator !== value.lastIndexOf(":")) throw new Error();
        kid = value.slice(0, separator);
        sec = value.slice(separator + 1);
      }
      if (!/^[A-Za-z0-9_-]+$/.test(kid) || !/^[A-Za-z0-9_-]+$/.test(sec)) throw new Error();
      process.stdout.write(JSON.stringify({kid, sec}));
    } catch (_) {
      process.exit(1);
    }
  '
}

# Internal implementation

create_key() {
  request=$(jq -nc --argjson expiry "$expiry" --argjson uses "$uses" '{expiry:$expiry,uses:$uses}')
  response=$(api POST '/api/keys' "$request") || exit $?

  if ! printf '%s' "$response" | jq -e '.id | type == "string" and length > 0' >/dev/null 2>&1 ||
     ! printf '%s' "$response" | jq -e '.key | type == "string" and length > 0' >/dev/null 2>&1; then
    err 'API response is missing key fields'
  fi

  kid=$(printf '%s' "$response" | jq -r '.id')
  validate_kid "$kid"

  printf '%s\n' "$response"
}

fetch_key() {
  validate_kid "$1"
  response=$(api GET "/api/keys/$1") || exit $?

  if ! printf '%s' "$response" | jq -e '.key | type == "string" and length > 0' >/dev/null 2>&1; then
    err 'API response is missing a key'
  fi

  printf '%s' "$response" | jq -r '.key'
}

# Subcommands

encrypt() {
  arg --define uses --short u --default 1
  arg --define expiry --short e --default 1
  arg --define format --short f --default blob
  arg --parse "$@"

  [ "$argc" -gt 0 ] || err 'encrypt: missing argument'
  [ "$argc" -eq 1 ] || err "encrypt: unexpected argument '$argv_1'"

  validate_endpoint
  validate_policy

  case "$format" in
    blob|url) ;;
    *) err "unknown format '$format'" ;;
  esac

  keypair=$(create_key)

  kid=$(printf '%s' "$keypair" | jq -r '.id')
  key=$(printf '%s' "$keypair" | jq -r '.key')

  ciphertext=$({
    printf '%s\n' "$key"
    if [ "$argv_0" = - ]; then
      cat
    else
      printf '%s' "$argv_0"
    fi
  } | crypto encrypt) || err 'could not encrypt'

  if [ "$format" = url ]; then
    printf '%s/receive?kid=%s&sec=%s\n' "$CIPHER_ENDPOINT" "$kid" "$ciphertext"
  else
    printf '%s:%s\n' "$kid" "$ciphertext"
  fi
}

decrypt() {
  arg --parse "$@"

  [ "$argc" -gt 0 ] || err 'decrypt: missing argument'
  [ "$argc" -eq 1 ] || err "decrypt: unexpected argument '$argv_1'"

  validate_endpoint

  if [ "$argv_0" = - ]; then
    parse_payload
  else
    parse_payload "$argv_0"
  fi

  key=$(fetch_key "$kid")

  { printf '%s\n' "$key"; printf '%s' "$ciphertext"; } | crypto decrypt || err 'could not decrypt'
}

keygen() {
  arg --define uses --short u --default 1
  arg --define expiry --short e --default 1
  arg --parse "$@"

  [ "$argc" -eq 0 ] || err "keygen: unexpected argument '$argv_0'"

  validate_endpoint
  validate_policy

  keypair=$(create_key)
  kid=$(printf '%s' "$keypair" | jq -r '.id')
  key=$(printf '%s' "$keypair" | jq -r '.key')

  printf '%s:%s\n' "$kid" "$key"
}

keyuse() {
  arg --parse "$@"

  [ "$argc" -gt 0 ] || err 'keyuse: missing argument'
  [ "$argc" -eq 1 ] || err "keyuse: unexpected argument '$argv_1'"

  validate_endpoint

  key=$(fetch_key "$argv_0")

  printf '%s\n' "$key"
}

inspect() {
  arg --parse "$@"

  [ "$argc" -gt 0 ] || err 'inspect: missing argument'
  [ "$argc" -eq 1 ] || err "inspect: unexpected argument '$argv_1'"

  validate_endpoint
  validate_kid "$argv_0"

  response=$(api GET "/api/keys/$argv_0/meta") || exit $?

  printf '%s\n' "$response"
}

case "${1:-}" in
  ''|-h|--help) usage ;;
  encrypt) encrypt "${@:2}" ;;
  decrypt) decrypt "${@:2}" ;;
  inspect) inspect "${@:2}" ;;
  keygen) keygen "${@:2}" ;;
  keyuse) keyuse "${@:2}" ;;
  *) err "unknown command '$1'" ;;
esac
